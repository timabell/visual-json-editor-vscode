// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "bun: compile",
			"detail": "Type-check, lint, and bundle the extension + webview into ./dist",
			"type": "shell",
			"command": "bun run compile",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$tsc",
			"presentation": {
				"reveal": "silent",
				"clear": true
			}
		}
	]
}
